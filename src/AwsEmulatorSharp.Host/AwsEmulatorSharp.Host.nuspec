<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>AwsEmulatorSharp.Host</id>
    <version>$version$</version>
    <authors>AwsEmulatorSharp</authors>
    <description>The AWS emulator host, published and ready to run from the folder the package is expanded into.</description>
    <dependencies>
      <group targetFramework="net10.0-windows7.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="**\*" target="." />
  </files>
</package>
